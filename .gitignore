# Local runtime state
.DS_Store
__pycache__/
*.pyc

# Grafana local config may include secrets if customized
observability/grafana/grafana.ini

# Local TLS certs (self‑signed)
observability/grafana/certs/*.key
observability/grafana/certs/*.crt

# Local Grafana data/db (not tracked)
observability/grafana/data/

# Prometheus TSDB data (not tracked)
observability/prometheus/data/

# node_exporter textfile output (generated)
observability/node_exporter/textfile/*.prom

# Promtail positions (generated)
observability/promtail/positions.yaml

# Any exported secrets files
*.env
*.secret

# Local artifacts
observability/output/

# Track central config
!observability/.env

# Ignore Grafana annotated config docs
observability/grafana/*.annotated.md
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
._*

__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
._*
INTERVIEW_GUIDE.md

.ruff_cache/
