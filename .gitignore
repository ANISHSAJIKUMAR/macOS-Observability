# Local runtime state
.DS_Store
__pycache__/
*.pyc

# Grafana local config may include secrets if customized
observability/grafana/grafana.ini

# Local Grafana data/db (not tracked)
observability/grafana/data/

# Prometheus TSDB data (not tracked)
observability/prometheus/data/

# node_exporter textfile output (generated)
observability/node_exporter/textfile/*.prom

# Any exported secrets files
*.env
*.secret
