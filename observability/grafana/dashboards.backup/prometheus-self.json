{
  "id": 10,
  "panels": [
    {
      "description": "Prometheus service health.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "down"
                },
                "1": {
                  "text": "up"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "(up{job=\"prometheus\"}) or on() vector(0)"
        }
      ],
      "title": "Prometheus Up",
      "type": "stat"
    },
    {
      "description": "How many active time series are in memory (head).",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "(prometheus_tsdb_head_series) or on() vector(0)"
        }
      ],
      "title": "TSDB Head Series",
      "type": "stat"
    },
    {
      "description": "Write\u2011ahead log size. Large WAL can indicate heavy ingestion.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "expr": "(prometheus_tsdb_wal_storage_size_bytes) or on() vector(0)"
        }
      ],
      "title": "WAL Size",
      "type": "stat"
    },
    {
      "description": "Total on\u2011disk blocks size.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "expr": "(prometheus_tsdb_storage_blocks_bytes) or on() vector(0)"
        }
      ],
      "title": "TSDB Blocks Size",
      "type": "stat"
    },
    {
      "description": "Configured storage cap for Prometheus.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "expr": "(prometheus_tsdb_retention_limit_bytes) or on() vector(0)"
        }
      ],
      "title": "Retention Limit",
      "type": "stat"
    },
    {
      "description": "How long each scrape takes. Spikes mean slow targets.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "(scrape_duration_seconds) or on() vector(0)",
          "legendFormat": "{{job}}"
        }
      ],
      "title": "Scrape Duration (s)",
      "type": "timeseries"
    },
    {
      "description": "Number of samples collected per scrape. Sudden jumps can indicate more metrics.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "(scrape_samples_scraped) or on() vector(0)",
          "legendFormat": "{{job}}"
        }
      ],
      "title": "Scrape Samples",
      "type": "timeseries"
    },
    {
      "description": "Time spent compacting TSDB blocks.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "expr": "(rate(prometheus_tsdb_compaction_duration_seconds_sum[5m])) or on() vector(0)",
          "legendFormat": "compaction"
        }
      ],
      "title": "Compaction Duration (s)",
      "type": "timeseries"
    },
    {
      "description": "Disk sync duration for WAL writes. High values indicate slow storage.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "expr": "(prometheus_tsdb_wal_fsync_duration_seconds) or on() vector(0)",
          "legendFormat": "fsync"
        }
      ],
      "title": "WAL Fsync Duration (s)",
      "type": "timeseries"
    },
    {
      "description": "Checksum of Prometheus config files for quick change detection.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "(prom_config_checksum) or on() vector(0)",
          "instant": true
        }
      ],
      "title": "Config Checksum",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "checksum"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "file": 0,
              "sha256": 1
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "prometheus",
    "self",
    "monitoring"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Prometheus: Self\u2011Monitoring",
  "uid": "prometheus-self",
  "version": 1
}
