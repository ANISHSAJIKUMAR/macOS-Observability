    {
      "description": "Lists which disks or volumes are taking the most space. Use this to find where storage is going (e.g., external drives, Time Machine).",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "expr": "topk(5, node_filesystem_size_bytes{fstype!~\"autofs\"} - node_filesystem_avail_bytes{fstype!~\"autofs\"})",
          "instant": true
        }
      ],
      "title": "Disk Usage (Top Mounts)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "used_bytes"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "device": 1,
              "mountpoint": 0,
              "used_bytes": 2
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Shows key identity facts like OS version, hardware model, CPU, memory, IP address, and Wi\u2011Fi name. Helpful for quick system overview without digging into system settings.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "expr": "mac_system_kv",
          "instant": true
        }
      ],
      "title": "System Identity",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "value"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "key": 0,
              "value": 1
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Single, easy\u2011to\u2011read value. Useful for quick checks and thresholds.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
