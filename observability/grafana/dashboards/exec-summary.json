    {
      "description": "Shows total internet traffic in and out. Spikes indicate downloads/uploads. Helpful to see if network use is causing slow browsing.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "expr": "sum(rate(node_network_receive_bytes_total[5m]))",
          "legendFormat": "RX"
        },
        {
          "expr": "sum(rate(node_network_transmit_bytes_total[5m]))",
          "legendFormat": "TX"
        }
      ],
      "title": "Network Throughput (bytes/s)",
      "type": "timeseries"
    },
    {
      "description": "Shows how fast your internet responds. Higher latency feels like lag. Useful for detecting slow or congested connections.",
