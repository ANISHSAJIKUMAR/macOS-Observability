          "expr": "(topk(5, node_filesystem_size_bytes{fstype!~\"autofs\"} - node_filesystem_avail_bytes{fstype!~\"autofs\"})) or on() vector(0)",
          "instant": true
        }
      ],
      "title": "Disk Usage (Top Mounts)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "used_bytes"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
