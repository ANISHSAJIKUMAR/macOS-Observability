      "targets": [
        {
          "expr": "(topk(10, node_filesystem_size_bytes{fstype!~\"autofs\"} - node_filesystem_avail_bytes{fstype!~\"autofs\"})) or on() vector(0)",
          "instant": true
        }
      ],
      "title": "Disk Usage by Mount (Used Bytes)",
      "transformations": [
