{
  "folderUid": "cfcclm6jxqvpcd",
  "id": 6,
  "panels": [
    {
      "description": "Quick guidance on interpreting key health signals.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "content": "## What to Watch\n- CPU or Memory > 85% sustained\n- Disk usage > 85% (/, AnishSSD, Time Machine)\n- Ping loss > 2% or latency spikes\n- Wi\u2011Fi RSSI below -70 dBm or SNR below 20 dB\n",
        "mode": "markdown"
      },
      "title": "What to Watch",
      "type": "text"
    },
    {
      "description": "High\u2011level KPIs for quick health status.",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "options": {
        "content": "",
        "mode": "markdown"
      },
      "title": "KPI Strip",
      "type": "text"
    },
    {
      "description": "Current CPU utilization.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "options": {
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) by (instance)) * 100"
        }
      ],
      "title": "CPU %",
      "type": "stat"
    },
    {
      "description": "RAM usage percentage.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "options": {
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "(node_memory_total_bytes - node_memory_free_bytes - node_memory_inactive_bytes - node_memory_purgeable_bytes) / node_memory_total_bytes * 100"
        }
      ],
      "title": "Memory %",
      "type": "stat"
    },
    {
      "description": "Primary disk usage.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "options": {
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100"
        }
      ],
      "title": "Disk / %",
      "type": "stat"
    },
    {
      "description": "Inbound bandwidth.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 4
      },
      "options": {
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rate(node_network_receive_bytes_total[5m]))"
        }
      ],
      "title": "Net RX",
      "type": "stat"
    },
    {
      "description": "Outbound bandwidth.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "options": {
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rate(node_network_transmit_bytes_total[5m]))"
        }
      ],
      "title": "Net TX",
      "type": "stat"
    },
    {
      "description": "Wi\u2011Fi signal strength.",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 20,
        "y": 4
      },
      "options": {
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "wifi_rssi_dbm"
        }
      ],
      "title": "Wi\u2011Fi RSSI",
      "type": "stat"
    },
    {
      "description": "Packet loss to public targets.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 2,
        "x": 22,
        "y": 4
      },
      "options": {
        "graphMode": "area",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "max(net_ping_loss_percent)"
        }
      ],
      "title": "Ping Loss",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "options": {
        "content": "## Read Me\nThis Grafana workspace monitors Anish's personal Mac with Prometheus + node_exporter.\n\nDashboards:\n- Mac System: Core Health \u2014 CPU, memory, disk usage (including AnishSSD + Time Machine), disk I/O\n- Mac Network: Connectivity & Wi\u2011Fi \u2014 throughput, errors/drops, ping health, Wi\u2011Fi signal/rates\n- Mac Info: Identity & Status \u2014 system identity, key specs, running launchd services\n- All Metrics: Live Explorer \u2014 all active Prometheus metrics (live only)\n\nRetention:\n- Prometheus data retention: 14 days\n- Storage cap: 20 GB\n\nExporters and launchd:\n- node_exporter (Homebrew service)\n- Custom exporters (launchd): net_connectivity, mac_system_info, launchd_metrics\n- Root daemon: wdutil_metrics for Wi\u2011Fi metrics\n",
        "mode": "markdown"
      },
      "title": "Read Me",
      "type": "text"
    },
    {
      "description": "Table view for System Information.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "expr": "mac_system_kv",
          "instant": true
        }
      ],
      "title": "System Information",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "value"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "key": 0,
              "value": 1
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Current value for Uptime.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "time() - node_boot_time_seconds",
          "legendFormat": ""
        }
      ],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "description": "Current value for CPU Cores.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 23
      },
      "targets": [
        {
          "expr": "mac_system_kv{key=\"cpu_cores\"}",
          "legendFormat": ""
        }
      ],
      "title": "CPU Cores",
      "type": "stat"
    },
    {
      "description": "Current value for Total Memory.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "node_memory_total_bytes",
          "legendFormat": ""
        }
      ],
      "title": "Total Memory",
      "type": "stat"
    },
    {
      "description": "Current value for Disk Used (/).",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 23
      },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100",
          "legendFormat": ""
        }
      ],
      "title": "Disk Used (/)",
      "type": "stat"
    },
    {
      "description": "Table view for Disk Usage by Mount (Used Bytes).",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "expr": "topk(10, node_filesystem_size_bytes{fstype!~\"autofs\"} - node_filesystem_avail_bytes{fstype!~\"autofs\"})",
          "instant": true
        }
      ],
      "title": "Disk Usage by Mount (Used Bytes)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "used_bytes"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "device": 1,
              "mountpoint": 0,
              "used_bytes": 2
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Current value for Launchd Jobs (Total).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 27
      },
      "targets": [
