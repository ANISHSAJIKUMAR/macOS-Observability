    {
      "description": "Shows how full a disk is. When storage is near full (>85%), the Mac may slow down and updates can fail. Helps decide when to delete files or move data.",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "targets": [
        {
          "expr": "((node_filesystem_size_bytes{mountpoint=\"/\"} - node_filesystem_avail_bytes{mountpoint=\"/\"}) / node_filesystem_size_bytes{mountpoint=\"/\"} * 100) or on() vector(0)",
          "legendFormat": ""
        }
      ],
      "title": "Disk Used (/)",
      "type": "stat"
    },
    {
      "description": "Shows how full a disk is. When storage is near full (>85%), the Mac may slow down and updates can fail. Helps decide when to delete files or move data.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
