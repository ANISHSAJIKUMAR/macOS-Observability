      "type": "stat"
    },
    {
      "description": "Table view for Launchd Jobs (Running).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "expr": "launchd_job_pid > 0",
          "instant": true
        }
      ],
      "title": "Launchd Jobs (Running)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "pid"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Value": 1,
              "label": 0
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Seconds since last scrape; higher means data is stale.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "targets": [
        {
