      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "{{filter}}",
          "noValue": "Unavailable"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Security Signals Over Time",
      "description": "Trends of security-related packet signals over time (SYN, RST, retransmissions, DNS, TLS, QUIC). Missing series are unavailable, not zero. Optional hardware, unmounted disks, stopped VMs and inactive collectors may have no samples.",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "(tshark_sec_frames_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Unavailable"
        }
      }
    },
    {
      "id": 13,
      "title": "Exporter age (seconds)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - tshark_metrics_timestamp_seconds",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 8,
        "h": 4
      },
