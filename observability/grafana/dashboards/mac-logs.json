    {
      "id": 8,
      "type": "logs",
      "title": "Wi\u2011Fi Logs (network issues)",
      "description": "Focused view of Wi\u2011Fi and network related logs. Use this when connectivity feels slow or unstable.",
      "datasource": {
        "type": "loki",
        "uid": "efccujve04lxca"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "{log_type=~\"wifi\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Keyword Search Results",
      "description": "Use the Search box to filter logs by keyword (e.g., error, failed). If Search is empty, this panel may be blank.",
      "datasource": {
        "type": "loki",
        "uid": "efccujve04lxca"
      },
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{job=~\"$job\",log_type=~\"$log_type\",filename=~\"$filename\"} |~ \"$search\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ],
  "description": "A human\u2011friendly log viewer for Anish\u2019s Mac. Use it to troubleshoot system issues, app crashes, and observability stack health. Filters at the top let you narrow by log source (system/user/observability), category (wifi/install/diagnostics/app), specific filename, and keyword search.\n\nHow to use: Start with the last 1 hour, set job=system, log_type=system. If you see a spike or error, open the row to read context and the exact file path."
}