    "logs",
    "loki",
    "mac"
  ],
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "observatory-loki"
        },
        "query": "label_values(job)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+"
      },
      {
        "name": "log_type",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "observatory-loki"
        },
        "query": "label_values(log_type)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+"
      },
      {
        "name": "filename",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "observatory-loki"
        },
        "query": "label_values(filename)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read Me: How to Use Logs",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "mode": "markdown",
        "content": "## Mac Logs — Quick Guide\nThis dashboard shows **system**, **app**, and **observability** logs in one place.\n\n**Best starting point**\n- Time range: **Last 1 hour**\n- job: **system**\n- log_type: **system** or **wifi**\n\n**Common searches**\n- `error`, `failed`, `panic`, `crash`\n- App names (e.g., `Chrome`, `Docker`, `Zoom`)\n\n**What each filter means**\n- **job**: system vs user vs observability\n- **log_type**: category like wifi/install/diagnostics/app\n- **filename**: exact file you want to tail\n- **search**: keyword in the log message\n\nTip: Expand a log row to see full metadata and the file path."
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Log Streams",
      "description": "Approximate number of active log streams ingested into Loki. If this is 0, logs are not being ingested.\n\nAuto‑fallback to 0 if metric is missing or has no recent samples. Missing series are unavailable, not zero. Optional hardware, unmounted disks, stopped VMs and inactive collectors may have no samples.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "observatory-loki"
      },
      "targets": [
        {
          "expr": "(count(count_over_time({job=~\"$job\",log_type=~\"$log_type\"}[5m]))) or on() vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Unavailable"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Log Ingestion Health",
      "description": "Promtail shipping status. If this is 0, Promtail is not sending logs to Loki.\n\nAuto‑fallback to 0 if metric is missing or has no recent samples. Missing series are unavailable, not zero. Optional hardware, unmounted disks, stopped VMs and inactive collectors may have no samples.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "(sum(rate(promtail_sent_bytes_total[5m])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Unavailable"
        }
      }
    },
    {
