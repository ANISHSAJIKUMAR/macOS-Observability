      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 10
      },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{mountpoint=\"/Volumes/Time Machine\"} - node_filesystem_avail_bytes{mountpoint=\"/Volumes/Time Machine\"}) / node_filesystem_size_bytes{mountpoint=\"/Volumes/Time Machine\"} * 100",
          "legendFormat": ""
