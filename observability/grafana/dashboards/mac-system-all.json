      },
      "targets": [
        {
          "expr": "(node_filesystem_size_bytes{mountpoint=\"/Volumes/AnishSSD\"} - node_filesystem_avail_bytes{mountpoint=\"/Volumes/AnishSSD\"}) / node_filesystem_size_bytes{mountpoint=\"/Volumes/AnishSSD\"} * 100",
          "legendFormat": ""
        }
      ],
