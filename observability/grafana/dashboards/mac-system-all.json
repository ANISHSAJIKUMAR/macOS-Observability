    {
      "description": "Table view for Disk Usage by Mount (Top Used %).",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "expr": "topk(10, (1 - node_filesystem_avail_bytes{fstype!~\"autofs\"} / node_filesystem_size_bytes{fstype!~\"autofs\"}) * 100)",
          "instant": true
        }
      ],
      "title": "Disk Usage by Mount (Top Used %)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "used_percent"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "device": 1,
              "mountpoint": 0,
              "used_percent": 2
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Table view for Disk Usage by Mount (Used Bytes).",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "expr": "topk(10, node_filesystem_size_bytes{fstype!~\"autofs\"} - node_filesystem_avail_bytes{fstype!~\"autofs\"})",
          "instant": true
        }
      ],
      "title": "Disk Usage by Mount (Used Bytes)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "used_bytes"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "device": 1,
              "mountpoint": 0,
              "used_bytes": 2
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "description": "Time series for CPU Usage (%).",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
