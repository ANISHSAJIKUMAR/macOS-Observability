      "targets": [
        {
          "expr": "topk(10, (1 - node_filesystem_avail_bytes{fstype!~\"autofs\"} / node_filesystem_size_bytes{fstype!~\"autofs\"}) * 100)",
          "instant": true
        }
      ],
      "title": "Disk Usage by Mount (Top Used %)",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "used_percent"
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "device": 1,
              "mountpoint": 0,
              "used_percent": 2
            }
          }
        }
      ],
      "type": "table"
    },
