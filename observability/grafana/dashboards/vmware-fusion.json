{
  "id": null,
  "uid": "vmware-fusion",
  "title": "VMware Fusion: VM Health",
  "tags": [
    "vmware",
    "virtualization",
    "system"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running VMs",
      "description": "How many VMware Fusion VMs are currently powered on.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(sum(vmware_fusion_vm_running)) or on() vector(0)"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Configured vCPU",
      "description": "Sum of vCPU assigned across all VMs (from .vmx).",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(sum(vmware_fusion_vm_config_vcpus)) or on() vector(0)"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Configured Memory (GB)",
      "description": "Sum of VM memory allocations (from .vmx).",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(sum(vmware_fusion_vm_config_mem_mb) / 1024) or on() vector(0)"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "VMs with Guest Tools",
      "description": "Count of running VMs with VMware Tools detected (guest IP available).",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(sum(vmware_fusion_vm_guest_tools)) or on() vector(0)"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU Usage by VM (%)",
      "description": "CPU usage per VM from the vmware-vmx process. Use this to spot noisy guests.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_cpu_percent) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory RSS by VM (MB)",
      "description": "Resident memory used by each VM process (vmware-vmx).",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_mem_mb) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Configured vCPU per VM",
      "description": "vCPU count from each VM's .vmx config.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_config_vcpus) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Configured Memory per VM (GB)",
      "description": "Configured memory allocation for each VM.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_config_mem_mb / 1024) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "VMDK Size per VM (GB)",
      "description": "Total size of disk files referenced in .vmx. Useful for capacity planning.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_vmdk_bytes / 1024 / 1024 / 1024) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Snapshot Count per VM",
      "description": "Number of snapshots (vmsn/vmss) per VM. Too many snapshots can slow VMs.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_snapshot_count) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Guest Tools Availability",
      "description": "Shows if VMware Tools (guest IP) is detected. 1=OK, 0=missing.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_guest_tools) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "VM Running State",
      "description": "Shows 1 if VM is running, 0 if stopped.",
      "datasource": {
        "type": "prometheus",
        "uid": "ffcch6jnmfvnka"
      },
      "targets": [
        {
          "expr": "(vmware_fusion_vm_running) or label_replace(vector(0), \"vm\", \"none\", \"\", \"\")"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      }
    },
    {
      "id": 13,
      "type": "text",
      "title": "About VMware Metrics",
      "description": "Notes about collection limitations and guest tools.",
      "options": {
        "mode": "markdown",
        "content": "This dashboard shows **host-side** metrics collected from VMware Fusion and vmware-vmx processes.\n\n**Guest OS metrics** (CPU/RAM inside the VM) require VMware Tools and a guest metrics agent. We currently detect Tools by checking for a guest IP.\n\nIf a VM shows 0 for disk size, the VMDK path is not visible or uses a storage layout not listed in the .vmx file."
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 6
      }
    }
  ]
}
