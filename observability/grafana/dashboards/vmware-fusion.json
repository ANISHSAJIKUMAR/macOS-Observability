{
  "id": null,
  "uid": "vmware-fusion",
  "title": "VMware Fusion: VM Health",
  "tags": [
    "vmware",
    "virtualization",
    "system"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Running VMs",
      "description": "How many VMware Fusion VMs are currently powered on. Missing series are unavailable, not zero. Optional hardware, unmounted disks, stopped VMs and inactive collectors may have no samples.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "(sum(vmware_fusion_vm_running))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Configured vCPU",
      "description": "Sum of vCPU assigned across all VMs (from .vmx). Missing series are unavailable, not zero. Optional hardware, unmounted disks, stopped VMs and inactive collectors may have no samples.",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "(sum(vmware_fusion_vm_config_vcpus))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable"
        }
      }
    },
