<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>observability.promtail</string>
    <key>ProgramArguments</key>
    <array>
      <string>PROJECT_ROOT_PLACEHOLDER/.local/bin/promtail</string>
      <string>-config.file=PROJECT_ROOT_PLACEHOLDER/observability/promtail/promtail-config.yml</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>PROJECT_ROOT_PLACEHOLDER/.local/var/log/promtail.log</string>
    <key>StandardErrorPath</key>
    <string>PROJECT_ROOT_PLACEHOLDER/.local/var/log/promtail.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
  </dict>
</plist>
