      "options": {
        "mode": "html",
        "content": "<div style=\"font-size: 15px; line-height: 1.5;\">\n  <div style=\"font-size: 22px; font-weight: 700; margin-bottom: 6px;\">Anish Laptop Observability</div>\n  <div style=\"opacity: 0.85; margin-bottom: 12px;\">Your personal, end\u2011to\u2011end monitoring command center.</div>\n  <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 12px;\">\n    <div>\n      <div style=\"font-weight: 700; margin-bottom: 6px;\">Pinned Dashboards (Start Here)</div>\n      <ul>\n        <li><a href=\"https://localhost:3000/d/exec-summary/executive-summary3a-anish-laptop\">Executive Summary</a> \u2014 interview\u2011friendly story</li>\n        <li><a href=\"https://localhost:3000/d/mac-system-all/mac-system3a-core-health\">Mac System: Core Health</a> \u2014 CPU, memory, disks, battery, thermal</li>\n        <li><a href=\"https://localhost:3000/d/mac-network/mac-network3a-connectivity-and-wie28091-fi\">Mac Network: Connectivity & Wi\u2011Fi</a> \u2014 throughput, drops, Wi\u2011Fi quality</li>\n        <li><a href=\"https://localhost:3000/d/mac-logs/mac-logs3a-system-apps-and-observability\">Mac Logs: System & Apps</a> \u2014 system + app logs</li>\n        <li><a href=\"https://localhost:3000/d/mac-security/mac-security3a-activity-and-risk-signals\">Mac Security: Activity & Risk Signals</a> \u2014 auth failures + security signals</li>\n        <li><a href=\"https://localhost:3000/d/prometheus-self/prometheus3a-selfe28091-monitoring\">Prometheus: Self\u2011Monitoring</a> \u2014 scrape health, TSDB, WAL</li>\n      </ul>\n    </div>\n    <div>\n      <div style=\"font-weight: 700; margin-bottom: 6px;\">Deep Dives</div>\n      <ul>\n        <li><a href=\"https://localhost:3000/d/mac-info/mac-info3a-identity-and-status\">Mac Info: Identity & Status</a> \u2014 identity + launchd</li>\n        <li><a href=\"https://localhost:3000/d/all-metrics-full/all-metrics3a-live-explorer\">All Metrics: Live Explorer</a> \u2014 raw metrics</li>\n        <li><a href=\"https://localhost:3000/d/tshark-live/mac-network3a-live-capture-tshark\">Live Capture (tshark)</a> \u2014 packet\u2011level analysis</li>\n      </ul>\n      <div style=\"margin-top: 10px; opacity: 0.85;\">Tip: Start here, then drill down when a metric looks abnormal.</div>\n    </div>\n  </div>\n</div>"
      },
      "transparent": true
    },
    {
      "description": "Prometheus service health (1=up).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "down"
                },
                "1": {
                  "text": "up"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
