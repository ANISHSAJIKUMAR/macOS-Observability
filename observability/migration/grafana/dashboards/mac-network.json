  "schemaVersion": 41,
  "tags": [
    "network",
    "mac",
    "node_exporter"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "en0",
          "value": "en0"
        },
        "datasource": "Prometheus",
        "includeAll": true,
        "label": "Interface",
        "multi": true,
        "name": "iface",
        "query": "label_values(node_network_receive_bytes_total, device)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
