    {
      "id": 14,
      "type": "timeseries",
      "title": "SYN Only (possible scans)",
      "description": "SYN packets without ACK can indicate port scans or connection spikes.",
      "gridPos": {
        "x": 0,
        "y": 77,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "tshark_sec_frames_total{filter=\"tcp.flags.syn==1 && tcp.flags.ack==0\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
