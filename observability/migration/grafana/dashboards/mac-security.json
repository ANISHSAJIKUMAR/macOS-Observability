      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "expr": "{job=~\"$job\",log_type=~\"$log_type\"} |~ \"(?i)(failed|denied|unauthorized|auth|login|sudo|root|gatekeeper|quarantine|keychain|firewall)\"",
          "refId": "A"
