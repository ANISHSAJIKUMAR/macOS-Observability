    {
      "id": 6,
      "type": "logs",
      "title": "Security\u2011Related Logs (Filtered)",
      "description": "Primary security log view. Shows only log lines containing security keywords.",
      "datasource": {
        "type": "loki",
        "uid": "efccujve04lxca"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "expr": "{job=~\"$job\",log_type=~\"$log_type\"} |~ \"(?i)(failed|denied|unauthorized|auth|login|sudo|root|gatekeeper|quarantine|keychain|firewall)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "dedupStrategy": "signature",
        "enableLogDetails": true,
        "prettifyLogMessage": true
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "User Activity Signals",
      "description": "Shows log lines that may indicate user activity such as logins, session starts, or app launches.\n\nAuto\u2011fallback to 0 if metric is missing or has no recent samples.",
      "datasource": {
        "type": "loki",
        "uid": "efccujve04lxca"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "({job=~\"$job\"} |~ \"(?i)(login|logout|session|launch|started|opened|signed in)\") or on() vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
