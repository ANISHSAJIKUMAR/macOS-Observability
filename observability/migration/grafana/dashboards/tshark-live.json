{
  "id": null,
  "uid": "tshark-live",
  "title": "Mac Network: Live Capture (tshark)",
  "description": "Live packet capture analytics from tshark. Use this to see real\u2011time throughput, top talkers, and protocol mix. This runs a short capture every minute on en0.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "network",
    "tshark",
    "pcap"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read Me",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "## Live Capture Overview\nThis dashboard uses **tshark** to sample traffic for 5 seconds every minute. It shows live throughput, protocol mix, and top conversations.\n\nIf you see **0** values, check that the interface is active (default `en0`) and tshark is running."
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Capture Success",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "tshark_capture_success",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Packets/sec",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "tshark_capture_pps",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Bytes/sec",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "tshark_capture_bps",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Frames Captured (window)",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "tshark_capture_frames_total",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Live Throughput (B/s)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "tshark_capture_bps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top Conversations by Bytes",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(5, tshark_conv_bytes_total)",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "{{src}} \u2192 {{dst}}"
        }
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Protocol Mix (Bytes)",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "expr": "topk(8, tshark_proto_bytes_total)",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "displayName": "{{proto}}"
        }
      }
    }
  ]
}