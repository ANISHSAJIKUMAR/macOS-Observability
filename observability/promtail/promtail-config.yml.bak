---
server:
  http_listen_address: 127.0.0.1
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /Users/anishskumar/Anish-DevOps-Lab/observability/promtail/positions.yaml

clients:
  - url: http://127.0.0.1:3100/loki/api/v1/push
    batchwait: 1s
    batchsize: 1048576
    backoff_config:
      min_period: 500ms
      max_period: 5s
      max_retries: 10

scrape_configs:
  - job_name: system_logs
    static_configs:
      - targets: [localhost]
        labels:
          job: system
          log_type: system
          __path__: /var/log/system.log
      - targets: [localhost]
        labels:
          job: system
          log_type: wifi
          __path__: /var/log/wifi.log
      - targets: [localhost]
        labels:
          job: system
          log_type: install
          __path__: /var/log/install.log
      - targets: [localhost]
        labels:
          job: system
          log_type: fsck
          __path__: /var/log/fsck_apfs.log
      - targets: [localhost]
        labels:
          job: system
          log_type: fsck_error
          __path__: /var/log/fsck_apfs_error.log
      - targets: [localhost]
        labels:
          job: system
          log_type: fsck_hfs
          __path__: /var/log/fsck_hfs.log
      - targets: [localhost]
        labels:
          job: system
          log_type: shutdown
          __path__: /var/log/shutdown_monitor.log
    pipeline_stages:
      - regex:
          expression: '^(?P<ts>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?)?\\s*(?:\\(.*\\))?\\s*<(?P<level>\\w+)>:.*$'
      - labels:
          level:

  - job_name: system_log_dirs
    static_configs:
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_messages
          __path__: /var/log/DiagnosticMessages/*
      - targets: [localhost]
        labels:
          job: system
          log_type: xpc_launchd
          __path__: /var/log/com.apple.xpc.launchd/*
      - targets: [localhost]
        labels:
          job: system
          log_type: wifi_analytics
          __path__: /var/log/com.apple.wifi.analytics/*.log
      - targets: [localhost]
        labels:
          job: system
          log_type: powermanagement
          __path__: /var/log/powermanagement/*
      - targets: [localhost]
        labels:
          job: system
          log_type: asl
          __path__: /var/log/asl/*.asl
    pipeline_stages:
      - drop:
          expression: '.+'
          # .asl files are binary/legacy and render as unreadable in Grafana

  - job_name: diagnostic_reports_system
    static_configs:
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports
          __path__: /Library/Logs/DiagnosticReports/*.diag
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports
          __path__: /Library/Logs/DiagnosticReports/*.crash
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports
          __path__: /Library/Logs/DiagnosticReports/*.panic
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports
          __path__: /Library/Logs/DiagnosticReports/*.spin
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports
          __path__: /Library/Logs/DiagnosticReports/*.hang
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports
          __path__: /Library/Logs/DiagnosticReports/*.cpu_resource.diag
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports
          __path__: /Library/Logs/DiagnosticReports/*.shutdownStall
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports_retired
          __path__: /Library/Logs/DiagnosticReports/Retired/*.diag
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports_retired
          __path__: /Library/Logs/DiagnosticReports/Retired/*.crash
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports_retired
          __path__: /Library/Logs/DiagnosticReports/Retired/*.panic
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports_retired
          __path__: /Library/Logs/DiagnosticReports/Retired/*.spin
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports_retired
          __path__: /Library/Logs/DiagnosticReports/Retired/*.hang
      - targets: [localhost]
        labels:
          job: system
          log_type: diagnostic_reports_retired
          __path__: /Library/Logs/DiagnosticReports/Retired/*.shutdownStall

  - job_name: diagnostic_reports_user
    static_configs:
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/*.diag
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/*.crash
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/*.panic
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/*.spin
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/*.hang
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports_retired
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/Retired/*.diag
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports_retired
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/Retired/*.crash
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports_retired
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/Retired/*.panic
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports_retired
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/Retired/*.spin
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports_retired
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/Retired/*.hang
      - targets: [localhost]
        labels:
          job: user
          log_type: diagnostic_reports_retired
          __path__: /Users/anishskumar/Library/Logs/DiagnosticReports/Retired/*.shutdownStall

  - job_name: app_logs_user
    static_configs:
      - targets: [localhost]
        labels:
          job: user
          log_type: app
          __path__: /Users/anishskumar/Library/Logs/*.log
      - targets: [localhost]
        labels:
          job: user
          log_type: app
          __path__: /Users/anishskumar/Library/Logs/*/*.log
      - targets: [localhost]
        labels:
          job: user
          log_type: app
          __path__: /Users/anishskumar/Library/Logs/*/*.txt

  - job_name: app_logs_system
    static_configs:
      - targets: [localhost]
        labels:
          job: system
          log_type: app
          __path__: /Library/Logs/*.log
      - targets: [localhost]
        labels:
          job: system
          log_type: app
          __path__: /Library/Logs/*/*.log
      - targets: [localhost]
        labels:
          job: system
          log_type: app
          __path__: /Library/Logs/*/*.txt

  - job_name: observability_logs
    static_configs:
      - targets: [localhost]
        labels:
          job: observability
          log_type: grafana
          __path__: /opt/homebrew/var/log/grafana/*.log
      - targets: [localhost]
        labels:
          job: observability
          log_type: grafana
          __path__: /opt/homebrew/var/log/grafana-stdout.log
      - targets: [localhost]
        labels:
          job: observability
          log_type: grafana
          __path__: /opt/homebrew/var/log/grafana-stderr.log
      - targets: [localhost]
        labels:
          job: observability
          log_type: prometheus
          __path__: /opt/homebrew/var/log/prometheus*.log
      - targets: [localhost]
        labels:
          job: observability
          log_type: node_exporter
          __path__: /opt/homebrew/var/log/node_exporter*.log
